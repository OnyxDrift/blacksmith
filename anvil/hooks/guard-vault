#!/usr/bin/env python3
"""PreToolUse hook: refuse Claude's Write/Edit/MultiEdit/NotebookEdit tools
inside the anvil vault and inside blacksmith's read-only repo cache.

Every vault write must go through `anvil note` (and friends), which enforce
the approval gate, the schema, and the origin rules. A direct file edit
would bypass all of them. Shell commands are not covered (a known limit);
the skills never write the vault that way.

Silent (exit 0, no output) for any path outside those two places.
"""
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
try:
    import anvil_common as ac
except Exception:
    sys.exit(0)  # never break editing because the guard itself is broken


def inside(path, root):
    root = os.path.realpath(root)
    return path == root or path.startswith(root + os.sep)


def main():
    try:
        data = json.load(sys.stdin)
    except Exception:
        return
    ti = data.get("tool_input") or {}
    target = ti.get("file_path") or ti.get("notebook_path") or ""
    if not target:
        return
    if not os.path.isabs(target):
        target = os.path.join(data.get("cwd") or os.getcwd(), target)
    real = os.path.realpath(target)

    cache = os.path.join(ac.CACHE_DIR, "repos")
    if inside(real, ac.vault()):
        reason = ("The anvil vault is written only through the anvil CLI, so the approval gate and "
                  "note rules apply. Use `anvil note` (draft, --approve, --amend, --set, --reject) "
                  "or `anvil domain add`; see the /anvil:note skill.")
    elif inside(real, cache):
        reason = ("This is blacksmith's read-only cache of another repo. Read it; do not edit it. "
                  "Changes belong in that repo's own clone.")
    else:
        return
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
    }}))


if __name__ == "__main__":
    main()
